%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c1e0a4b9d2f4e6a8b0c1d2e3f405162, type: 3}
  m_Name: StoryCatalog
  m_EditorClassIdentifier: 
  _nodes:
  - id: "intro_001"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "欢迎欢迎！你就是我们NESTHOME的新成员吧！怎么称呼呀！"
    nextId: "intro_002"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_002"
    kind: 1
    speakerIds: []
    text: "(弹出改名框)"
    nextId: "intro_003"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_003"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "欢迎xxx！来这边沙发坐下吧，待会就要开始我们的头脑风暴了。"
    nextId: "intro_004"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_004"
    kind: 1
    speakerIds:
    - "过渡"
    text: "(等待玩家wasd走到沙发交互坐下)"
    nextId: "intro_005"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "greet_1_001"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "你好呀，我是北街，很高兴认识你！"
    nextId: ""
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "greet_2_001"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "叫我阿闲就好，你想和我们做一辈子游戏嘛（眨眼）"
    nextId: ""
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "greet_3_001"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "你好呀，我是归云，北街说他很高兴认识你！"
    nextId: ""
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "greet_4_001"
    kind: 0
    speakerIds:
    - "dao_xia"
    text: "终于等到你...！想和我一起画画吗喵！"
    nextId: ""
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "greet_5_001"
    kind: 0
    speakerIds:
    - "miao_miao"
    text: "……你，你好"
    nextId: ""
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "greet_6_001"
    kind: 0
    speakerIds:
    - "liang_feng"
    text: "（高冷）"
    nextId: ""
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_005"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "大家都准备好了吗，坐好咯，我要发车了，我开个会议录制记录一下我们说了啥，我们差不多就开始了。"
    nextId: "intro_006"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_006"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "真期待这一次的游戏呀！不知道我们会做出什么有趣的游戏呢？我坐好了。"
    nextId: "intro_007"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_007"
    kind: 1
    speakerIds:
    - "gui_yun"
    text: "(开启会议录制)"
    nextId: "intro_008"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_008"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "这次GameJam主题是“涌现”，那我们逐个简单介绍一下自己的想法吧！"
    nextId: "intro_009"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "intro_009"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "那就我先开始吧！诶，我有一个点子……"
    nextId: "music_001"
    sceneLabel: "游戏开始"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_001"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "说到涌现，我觉得最直观的就是泉水的“涌现”了......"
    nextId: "music_fade_in"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_fade_in"
    kind: 1
    speakerIds: []
    text: "(逐渐黑屏并转入神秘音游)"
    nextId: "music_002"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_002"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "我们做一个音游吧！"
    nextId: "music_003"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_003"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "玩家扮演地下的泉水，从地底深处出发，绕过岩层，在缝隙中穿行，最终到达地面，涌现而出，成为美丽的喷泉！"
    nextId: "music_004"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_004"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "我们是一汪高雅的泉水，所以需要玩家随着音乐的节拍正确敲下对应按键，才能流向正确的路线哦。"
    nextId: "music_005"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_005"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "这里就假设点击“空格”吧！"
    nextId: "music_space_prompt"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_space_prompt"
    kind: 1
    speakerIds: []
    text: "出现浮窗（请点击空格）"
    nextId: "music_006"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_006"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "通过玩家敲击的时间与节拍的时间之差判定 miss/good/perfect ，"
    nextId: "music_007"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_007"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "从而决定泉水往哪个方向的地下通道前往地面。（泉水开始向上，地下周围景物向下，玩家可以跟着简单的固定节拍来敲空格）"
    nextId: "music_008"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_008"
    kind: 1
    speakerIds: []
    text: "（玩家体验游戏，直至泉水到达地面）"
    nextId: "music_009"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_009"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "玩家操控的泉水最终就能涌出地面！成为喷泉！冷知识：完成度越高喷泉到达高度越高哦！"
    nextId: "music_010"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_010"
    kind: 1
    speakerIds: []
    text: "（游戏结束，根据玩家游玩情况给出地面高度）"
    nextId: "music_011"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_011"
    kind: 2
    speakerIds: []
    text: "还想要再玩一次"
    nextId: "music_002"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: "music_replay"
  - id: "music_012"
    kind: 2
    speakerIds: []
    text: "我理解了，回到讨论界面"
    nextId: "music_013"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: "music_replay"
  - id: "music_013"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "我们的亮点在于判定的形式上更有创造力，如果要完善的话还可以加更多有意思的路线机制进去呢！"
    nextId: "music_014"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_014"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "但是这个对于我们的音乐和美术要求较高啦（挠头）"
    nextId: "music_exhausted"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_exhausted"
    kind: 1
    speakerIds: []
    text: "（此处插入刀夏和light的力竭表情）"
    nextId: "music_015"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "music_015"
    kind: 0
    speakerIds:
    - "a_xian"
    text: "我的想法就是这个啦！你们觉得怎么样？我好想赶紧做出来！"
    nextId: "evolution_001"
    sceneLabel: "神秘音游"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_001"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "你的想法好新颖！"
    nextId: "evolution_002"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_002"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "但是剧情好简单欸！"
    nextId: "evolution_003"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_003"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "身为身负巨大使命的玩家大人来说，怎么能不给他们一个光荣的身份呢！"
    nextId: "evolution_004"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_004"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "身为一个涌现为主题的游戏，当然离不开我们的创世神话啦！这可是生命的涌现呢！（开始逐渐黑屏"
    nextId: "evolution_005"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_005"
    kind: 1
    speakerIds: []
    text: "(黑屏切入进化之地demo)"
    nextId: "evolution_006"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_006"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "（这是一个漆黑的世界....有的只有那一汪世界之泉..(还是从上一个游戏里面涌现出来的泉水呢！）"
    nextId: "evolution_007"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_007"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "一颗种子深埋在世界中心，但是没有泉水浇灌，于是它一直在沉睡，一直在等待...直到！你的到来！"
    nextId: "evolution_008"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_008"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "拯救这个世界的勇者啊！请把泉水引到世界中心吧！"
    nextId: "evolution_009"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_009"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "玩家请前进推动巨石填充坑洞，让泉水可以顺利流过，成功灌溉世界之种。"
    nextId: "evolution_010"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_010"
    kind: 1
    speakerIds: []
    text: "（玩家开始推动石头）"
    nextId: "evolution_011"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_011"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "加油啊！勇者大人！世界就交给你了！"
    nextId: "evolution_012"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_012"
    kind: 1
    speakerIds: []
    text: "（成功填充，水流流动动画，种子发芽长出嫩芽动画）"
    nextId: "evolution_013"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_013"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "感谢你的壮举！世界的第一株生命开始生长，这单调的世界终于出现了第一抹绿！"
    nextId: "evolution_014"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_014"
    kind: 1
    speakerIds: []
    text: "（开始出现第一只怪物）"
    nextId: "evolution_015"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_015"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "不好！ 在这单调世界的唯一绿色过于亮眼了，虚无兽涌过来了！他们要摧毁生命，让世界重回虚无！"
    nextId: "evolution_016"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_016"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "伟大的勇者呀，请继续守护我们的世界之苗吧！直到它长成世界之树，就可以庇佑这片大地了！"
    nextId: "evolution_017"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_017"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "（请玩家按下鼠标左键进行攻击，坚持到幼苗长成大树。"
    nextId: "evolution_018"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_018"
    kind: 1
    speakerIds: []
    text: "（玩家开始打怪）"
    nextId: "evolution_019"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_019"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "坚持住，勇者大人！"
    nextId: "evolution_020"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_020"
    kind: 1
    speakerIds: []
    text: "（战斗结束后）"
    nextId: "evolution_021"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_021"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "再次感谢你的壮举！你再次守护了这个世界！"
    nextId: "evolution_022"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_022"
    kind: 1
    speakerIds: []
    text: "（逐渐黑屏，转入下一关）"
    nextId: "evolution_023"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_023"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "仅靠这一汪泉水似乎并不足以支撑世界之树的生长，"
    nextId: "evolution_024"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_024"
    kind: 1
    speakerIds: []
    text: "（切俯视视角）"
    nextId: "evolution_025"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_025"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "这里还有几汪泉水，请勇者大人再次尝试引水吧"
    nextId: "evolution_026"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_026"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "请玩家操控对应水道，将其并放到正确位置，然后引通水流，到达树苗处"
    nextId: "evolution_027"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_027"
    kind: 1
    speakerIds:
    - "gui_yun"
    text: "tips:有时候仅靠一个视角并不能总览全局哦，请按下R键尝试切换视角"
    nextId: "evolution_030"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_028"
    kind: 1
    speakerIds: []
    text: "(如果解密失败）"
    nextId: "evolution_029"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_029"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "你似乎不怎么会解密呢，没关系，我来助你（自动完成关卡）"
    nextId: "evolution_031"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_030"
    kind: 1
    speakerIds: []
    text: "（完成后）"
    nextId: "evolution_031"
    sceneLabel: "进化之地"
    failureNextId: "evolution_028"
    choiceGroup: ""
  - id: "evolution_031"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "世界之树得到了充分的灌溉，接下来，我们只需等待...."
    nextId: "evolution_032"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_032"
    kind: 1
    speakerIds: []
    text: "(传来啃食的声音）"
    nextId: "evolution_033"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_033"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "什么声音？！"
    nextId: "evolution_034"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_034"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "让勇者大人爬上树上看看吧"
    nextId: "evolution_035"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_035"
    kind: 1
    speakerIds: []
    text: "（播放爬树动画）（怪物嘶吼，跳下）"
    nextId: "evolution_036"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_036"
    kind: 0
    speakerIds:
    - "bei_jie"
    text: "居然是虚无兽王，这将是最惊险的一场战斗了！勇者大人，坚持住！"
    nextId: "evolution_037"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_037"
    kind: 0
    speakerIds:
    - "gui_yun"
    text: "兽王的智力较低，勇者可尝试引诱它撞击墙面造成眩晕，并趁机攻击哦"
    nextId: "evolution_041"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_038"
    kind: 1
    speakerIds: []
    text: "（失败战斗结束）"
    nextId: "evolution_039"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_039"
    kind: 0
    speakerIds:
    - "bei_jie"
    - "gui_yun"
    text: "伟大的勇者啊，就让我们来助你！"
    nextId: "evolution_040"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_040"
    kind: 1
    speakerIds: []
    text: "（强行结束游戏，并播放胜利战斗结束对话）"
    nextId: "evolution_041"
    sceneLabel: "进化之地"
    failureNextId: ""
    choiceGroup: ""
  - id: "evolution_041"
    kind: 1
    speakerIds: []
    text: "（胜利战斗结束）"
    nextId: "evolution_042"
    sceneLabel: "进化之地"
    failureNextId: "evolution_038"
    choiceGroup: ""
  - id: "evolution_042"
    kind: 0
    speakerIds:
    - "bei_jie"
    - "gui_yun"
